{
  "name": "ms-icon",
  "version": "1.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "update": "node ./dev/update.js",
    "build": "node ./dev/build.js"
  },
  "keywords": [
    "material",
    "icons",
    "symbols",
    "material symbols",
    "material symbols icons",
    "svg",
    "material symbols svg",
    "material symbols icons svg"
  ],
  "author": "miralm",
  "repository": "miralm-ltd/ms-icon",
  "license": "MIT",
  "description": "This library provides Google Material Symbols icons as components, SVGs, and icon fonts.",
  "exports": {
    ".": {
      "types": "./main.d.ts",
      "default": "./main.js"
    },
    "./*.svg": "./icons/*.svg",
    "./*.woff2": "./fonts/*.woff2",
    "./outlined": {
      "types": "./type.d.ts",
      "default": "./components/outlined.js"
    },
    "./rounded": {
      "types": "./type.d.ts",
      "default": "./components/rounded.js"
    },
    "./sharp": {
      "types": "./type.d.ts",
      "default": "./components/sharp.js"
    },
    "./outlined/*": {
      "types": "./type.d.ts",
      "default": "./components/outlined/*.js"
    },
    "./rounded/*": {
      "types": "./type.d.ts",
      "default": "./components/rounded/*.js"
    },
    "./sharp/*": {
      "types": "./type.d.ts",
      "default": "./components/sharp/*.js"
    },
    "./*": {
      "types": "./type.d.ts",
      "default": "./components/outlined/*.js"
    }
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://ifdian.net/a/apprat"
    }
  ]
}